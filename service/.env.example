# === Service (serverda ishlaydi) ===

# Service qaysi portda tinglaydi (admin panel shu portga ulanadi)
PORT=4000

# kamera.db saqlanadigan katalog. Docker'da bu ./data volume'ga ulanadi,
# shuning uchun konteyner qayta ishga tushsa ham baza yo'qolmaydi.
DATA_DIR=data

# Admin panel bilan service o'rtasidagi maxfiy kalit.
# Admin paneldagi NUXT_SERVICE_API_KEY bilan BIR XIL bo'lishi shart.
SERVICE_API_KEY=ALMASHTIRING-uzun-tasodifiy-kalit

# Stream token'larni imzolash uchun maxfiy kalit (boshqa, uzun, tasodifiy)
JWT_SECRET=ALMASHTIRING-yana-bir-uzun-tasodifiy-kalit

# Tomosha tokeni qancha amal qiladi (soniya). Qisqa bo'lgani xavfsizroq.
TOKEN_TTL_SECONDS=60

# MediaMTX HTTP API manzili (odatda shu serverning o'zida)
MEDIAMTX_API=http://127.0.0.1:9997

# Tashqariga chiqadigan oqim URL'lari uchun asosiy domen/manzil.
# Cloudflare Tunnel yoki domeningiz. Vaqtincha server IP ham bo'ladi.
STREAM_BASE=https://stream.institut.uz

# Kamera brendiga qarab default RTSP yo'li.
# Hikvision: Streaming/Channels/101 | Dahua: cam/realmonitor?channel=1&subtype=0
DEFAULT_RTSP_PATH=Streaming/Channels/101
