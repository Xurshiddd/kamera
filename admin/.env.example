# === Admin panel (static SPA) ===

# Boshqa serverdagi service manzili (bir LAN'da IP, yoki domen).
# Brauzer to'g'ridan shu manzilga ulanadi — build (generate) paytida o'qiladi.
# Masalan lokal tarmoqda: http://192.168.1.50:4000
NUXT_PUBLIC_SERVICE_BASE=http://192.168.1.50:4000

# Eslatma: kirish paroli va API kalit endi SERVICE tomonda (.env) saqlanadi,
# bu yerda emas. Login service'da tekshiriladi (ADMIN_PASSWORD).
