# === Admin panel ===

# Serverdagi service manzili (IP yoki domen).
# Masalan lokal tarmoqda: http://192.168.1.50:4000
# yoki tashqaridan: https://service.institut.uz
NUXT_PUBLIC_SERVICE_BASE=http://192.168.1.50:4000

# Service'dagi SERVICE_API_KEY bilan BIR XIL bo'lishi shart.
NUXT_SERVICE_API_KEY=ALMASHTIRING-uzun-tasodifiy-kalit

# Panelga kirish paroli. Panel ochilganda shu parol so'raladi.
NUXT_ADMIN_PASSWORD=ALMASHTIRING-kuchli-parol

# Session cookie'ni imzolash uchun maxfiy kalit (uzun, tasodifiy).
NUXT_SESSION_SECRET=ALMASHTIRING-yana-bir-uzun-tasodifiy-kalit
