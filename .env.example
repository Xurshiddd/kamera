# Nusxa oling: cp .env.example .env  — va qiymatlarni ALMASHTIRING.

# Admin panelga kirish paroli (brauzerdagi SPA shu parolni so'raydi).
ADMIN_PASSWORD=ALMASHTIRING-kuchli-parol

# Admin session tokenlarini imzolash kaliti (uzun, tasodifiy):
#   openssl rand -base64 32
JWT_SECRET=ALMASHTIRING-uzun-tasodifiy-kalit

# Server-to-server chaqiruvlar uchun API kalit (masalan LMS backend'i
# "x-api-key" sarlavhasi bilan kamera API'sini chaqirsa).
SERVICE_API_KEY=ALMASHTIRING-boshqa-uzun-kalit

# Brauzer ko'radigan HLS manzili. Hestia cam.ttysi.uz ni shu serverning
# 3000-portiga proxy qiladi, HLS esa /hls yo'lidan statik beriladi:
#   https://cam.ttysi.uz/hls/{slug}/index.m3u8
STREAM_BASE=https://cam.ttysi.uz/hls

# H265 transkod chiqishining balandligi (kenglik nisbatga qarab avtomatik).
# CPU og'irlik qilsa 480 ga tushiring (~2x yengil). H264 (copy) kameralarga
# ta'sir qilmaydi.
VIDEO_HEIGHT=720

# Kamera brendiga qarab default RTSP yo'li (forma bo'sh qoldirilsa).
# Hikvision: Streaming/Channels/101 | Dahua: cam/realmonitor?channel=1&subtype=0
DEFAULT_RTSP_PATH=Streaming/Channels/101
